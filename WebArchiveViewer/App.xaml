<Application x:Class="WebArchiveViewer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:WebArchiveViewer"
             xmlns:commandsLocal="clr-namespace:WebArchiveViewer.UI.Commands"
             xmlns:commands="clr-namespace:WebArchiveViewer.WpfUI.Commands;assembly=WebArchive.WpfUI"
             StartupUri="Views/Windows/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <commands:OpenLinkCommand x:Key="OpenLinkCommand" />
            <commandsLocal:OpenExceptionWindowCommand x:Key="OpenExceptionCommand" />

            <ResourceDictionary.MergedDictionaries>

                <ResourceDictionary Source="Resources/Converters.xaml" />


                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Panels.xaml" />
                <ResourceDictionary Source="Resources/Styles/Dates.xaml" />
                <ResourceDictionary Source="Resources/Styles/Buttons.xaml" />
                <ResourceDictionary Source="Resources/Styles/TreeView.xaml" />
                <ResourceDictionary Source="Resources/Styles/Text.xaml" />
                <ResourceDictionary Source="Resources/Styles/Menu.xaml" />
                <ResourceDictionary Source="Resources/Styles/ComboBox.xaml" />
                <ResourceDictionary Source="Resources/Styles/TabControl.xaml" />
                <ResourceDictionary Source="Resources/Styles/Expanders.xaml" />

                <ResourceDictionary Source="Resources/DataTemplates/EventArgs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
