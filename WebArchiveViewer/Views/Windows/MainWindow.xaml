<Window
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebArchiveViewer"
        xmlns:controls="clr-namespace:WebArchiveViewer.Views.Controls"
        xmlns:System="clr-namespace:System;assembly=mscorlib"
    
        xmlns:LibParts="clr-namespace:WebArchive.Data.RequestParts;assembly=WebArchive.Data"
    
    xmlns:Lib="clr-namespace:WebArchive.Data;assembly=WebArchive.Data"
    xmlns:viewmodels="clr-namespace:WebArchiveViewer.ViewModels"
    
    xmlns:htmload="clr-namespace:WebArchive.Data.HtmlLoading;assembly=WebArchive.Data"
    xmlns:linkload="clr-namespace:WebArchive.Data.Loaders;assembly=WebArchive.Data"
    x:Class="WebArchiveViewer.MainWindow"
        mc:Ignorable="d" Icon="../../Resources/Веб-архив.png"
        Title="Исследователь Веб-Архива" Height="800" Width="1280"
        Closed="Window_Closed">
    <Window.DataContext>
        <local:MainWindowViewModel />
    </Window.DataContext>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Menu IsMainMenu="True" Padding="3,6" FontSize="14" VerticalAlignment="Top" Background="WhiteSmoke" BorderThickness="0,0,0,1" BorderBrush="Gainsboro">
            <MenuItem Header="Открыть">
                <MenuItem Header="Файл" Command="{Binding SnapshotLoader.LoadFromFileCommand}" />
            </MenuItem>

            <MenuItem Header="Сохранить" Command="{Binding SnapshotView.SaveSnapFileCommand}" CommandParameter="AllDefaultPath" />
            <MenuItem Header="Сохранить как">
                <MenuItem Header="Все ссылки" Command="{Binding SnapshotView.SaveSnapFileCommand}" CommandParameter="All" />
                <MenuItem Header="Все ссылки по условию" Command="{Binding SnapshotView.SaveSnapFileCommand}" CommandParameter="AllFiltered"/>
                <MenuItem Header="Все ссылки кроме по условию" Command="{Binding SnapshotView.SaveSnapFileCommand}" CommandParameter="AllNotFiltered"/>
            </MenuItem>

            <MenuItem Header="Закрыть" Command="{Binding CloseSnapCommand}" />
            <Separator />
            <MenuItem Header="О программе" Click="AboutMenuItem_Click"/>

        </Menu>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="20*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <!--Настройка-->
            <Border Grid.RowSpan="4">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" BorderBrush="Gainsboro" BorderThickness="0,1" Padding="15,5" DataContext="{Binding SnapshotView.ViewOptions}">
                        <StackPanel>
                            <DockPanel>
                                <TextBlock Text="Отображаемые столбцы:" Margin="-15,0" Style="{DynamicResource Header}" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding ShowColumns.Columns}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding Shown}" Margin="15,2">
                                            <DockPanel>
                                                <TextBlock Text="{Binding Order,StringFormat=\{0\})}" Margin="2,0" FontSize="12" />
                                                <TextBlock Text="{Binding Name}" FontSize="12" />
                                            </DockPanel>
                                        </CheckBox>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <StackPanel Grid.Row="1" Margin="15,5">
                        <DockPanel>
                            <TextBlock Text="Категории:"  Style="{DynamicResource Header}" />
                            <DockPanel HorizontalAlignment="Right">
                                <Button Command="{Binding SnapshotView.RulesView.OpenRulesWindowCommand}" ToolTip="Показать правила построения категорий" Content="[ ? ]" Margin="4,0" Padding="1,0" BorderThickness="0"  />
                                <Button Command="{Binding SnapshotView.ViewOptions.ToggleCategoriesCommand}" ToolTip="Переключить видимость всех категорий" Content="[ ~ ]" Margin="1,0" Padding="1,0" BorderThickness="0"  />
                            </DockPanel>
                        </DockPanel>
                    </StackPanel>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" Padding="0,5">
                        <TreeView ItemsSource="{Binding SnapshotView.ViewOptions.Categories}" BorderThickness="0" ItemContainerStyle="{StaticResource TreeViewStrech}">
                            <TreeView.ItemTemplate>
                                <HierarchicalDataTemplate ItemsSource="{Binding InnerCates}">
                                    <ToggleButton x:Name="btn" IsChecked="{Binding Enabled}"  Click="ToggleButton_Click" Padding="15,0" HorizontalContentAlignment="Stretch" Margin="1" BorderThickness="0,0,0,1">
                                        <DockPanel Margin="0,1">
                                            <TextBlock Text="{Binding Name}" FontSize="12"/>
                                            <DockPanel HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding ItemsAmount}" FontSize="10"/>
                                                <TextBlock Text="/" Margin="3,0" FontSize="10"/>
                                                <TextBlock Text="{Binding ItemsTotal}" FontSize="10"/>
                                            </DockPanel>
                                        </DockPanel>
                                    </ToggleButton>
                                </HierarchicalDataTemplate>
                            </TreeView.ItemTemplate>
                        </TreeView>
                    </ScrollViewer>

                </Grid>
            </Border>

            <GridSplitter Grid.Column="1" Grid.RowSpan="4" Width="2" VerticalAlignment="Stretch" HorizontalAlignment="Center" />

            <!--Заголовок-->
            <Border Grid.Row="0" Grid.Column="2" BorderThickness="0,0,0,1" BorderBrush="Gainsboro">
                <Grid Margin="10,3">
                    <DockPanel Margin="0">
                        <TextBlock Grid.Row="0"
                                   Text="{Binding SnapshotView.CurrentSnapshot.SourceURI,TargetNullValue=Ссылки не загружены,FallbackValue=Ссылки не загружены}"
                                   FontSize="24" Margin="0,0,10,0"/>

                        <DockPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                            <TextBlock FontSize="18" Text="{Binding SnapshotView.ViewOptions.LinksFilteredAmount}" VerticalAlignment="Center" Margin="5,0" />
                            <TextBlock FontSize="18" Text="/" VerticalAlignment="Center" Margin="5,0"/>
                            <TextBlock FontSize="18" Text="{Binding SnapshotView.CurrentSnapshot.Links.Length}" VerticalAlignment="Center" Margin="5,0" />
                        </DockPanel>
                    </DockPanel>
                </Grid>
            </Border>

            <!--Список-->
            <Border Grid.Row="1" Grid.Column="2" Margin="0,5">
                <TabControl BorderThickness="0,1,0,0">
                    <TabItem DataContext="{Binding SnapshotLoader}">
                        <TabItem.Header>
                            <TextBlock Text="Получение снапшота" FontSize="16" />
                        </TabItem.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <ScrollViewer Grid.Column="0" x:Name="elem" VerticalScrollBarVisibility="Auto">
                                <TabControl>
                                    <TabItem>
                                        <TabItem.Header>
                                            <TextBlock Text="Запрос к веб-архиву" />
                                        </TabItem.Header>
                                        <StackPanel Margin="5,0">
                                            <StackPanel>
                                                <StackPanel>
                                                    <DockPanel Style="{StaticResource Property}">
                                                        <TextBlock Text="Ссылка:" ToolTip="{Binding RequestString}" Style="{StaticResource PropertyName}" />
                                                        <TextBox Text="{Binding RequestBuilder.Site.Value}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource Property}">
                                                        <TextBlock Text="Поиск:" ToolTip="{Binding RequestString}" Style="{StaticResource PropertyName}" />
                                                        <ComboBox ItemsSource="{Binding RequestBuilder.MatchType.Types}" SelectedItem="{Binding RequestBuilder.MatchType.Selected}" VerticalAlignment="Center">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="Gray"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource Property}">
                                                        <TextBlock Text="Вывод:" ToolTip="{Binding RequestString}" Style="{StaticResource PropertyName}" />
                                                        <ComboBox ItemsSource="{Binding RequestBuilder.Output.Types}" SelectedItem="{Binding RequestBuilder.Output.Selected}" VerticalAlignment="Center" IsEnabled="False" >
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate>
                                                                    <StackPanel>
                                                                        <TextBlock Text="{Binding Name}" ToolTip="{Binding Description}" />
                                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="Gray"/>
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </DockPanel>
                                                    <DockPanel Style="{StaticResource Property}">
                                                        <TextBlock Text="Лимит:" Style="{StaticResource PropertyName}" />
                                                        <StackPanel Style="{StaticResource PropertiesPanel}">

                                                            <TextBlock>
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Text" Value="{Binding RequestBuilder.Limit.Amount}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RequestBuilder.Limit.Amount}" Value="-1">
                                                                                <Setter Property="Text" Value="Без ограничений" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                            <Slider Minimum="{Binding RequestBuilder.Limit.Min}"
                                                                    Maximum="{Binding RequestBuilder.Limit.Max}"
                                                                    Value="{Binding RequestBuilder.Limit.Amount}" />

                                                            <!--ВАРИАНТ 3-->
                                                            <TextBlock Text="Внимание! Без лимита загрузка всех данных может занять много времени"
                                                                       Foreground="Red" FontSize="11">
                                                                <TextBlock.Style>
                                                                    <Style TargetType="TextBlock">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RequestBuilder.Limit.Amount}" Value="-1">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </TextBlock.Style>
                                                            </TextBlock>

                                                        </StackPanel>
                                                    </DockPanel>

                                                    <DockPanel Style="{StaticResource Property}">
                                                        <StackPanel VerticalAlignment="Top">
                                                            <TextBlock Text="Даты:" Style="{StaticResource PropertyName}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <WrapPanel Margin="0,5">
                                                                <RadioButton GroupName="dates" IsChecked="{Binding RequestBuilder.Dates.Enabled}" >
                                                                    <TextBlock Text="c ограничениями" />
                                                                </RadioButton>
                                                                <RadioButton GroupName="dates" Margin="5,0">
                                                                    <TextBlock Text="без ограничений" />
                                                                </RadioButton>
                                                            </WrapPanel>
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <TextBlock>
                                                                        <Run Text="С" />
                                                                        <Run Text="{Binding RequestBuilder.Dates.Range.From, Mode=OneWay, Converter={StaticResource DateConverter}, ConverterParameter=dd MMMM yyyy}" />
                                                                    </TextBlock>
                                                                    <DatePicker SelectedDate="{Binding RequestBuilder.Dates.Range.From}" />
                                                                    <DockPanel HorizontalAlignment="Right">
                                                                        <TextBlock>
                                                                            <Run Text="по" />
                                                                            <Run Text="{Binding RequestBuilder.Dates.Range.To, Mode=OneWay, Converter={StaticResource DateConverter}, ConverterParameter=dd MMMM yyyy}" />
                                                                        </TextBlock>
                                                                        <DatePicker SelectedDate="{Binding RequestBuilder.Dates.Range.To}" />
                                                                    </DockPanel>
                                                                </DockPanel>
                                                                <local:IntervalSlider Minimum="0" Maximum="{Binding RequestBuilder.Dates.Range.Difference}" LowerValue="{Binding RequestBuilder.Dates.Range.DifferenceFrom, Mode=TwoWay}" UpperValue="{Binding RequestBuilder.Dates.Range.DifferenceTo, Mode=TwoWay}"/>
                                                                <StackPanel.Style>
                                                                    <Style TargetType="StackPanel" BasedOn="{StaticResource PropertiesPanel}">
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding RequestBuilder.Dates.Enabled}" Value="false">
                                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </StackPanel.Style>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>


                                                    <DockPanel Style="{StaticResource Property}">
                                                        <TextBlock Text="MIME-типы:" Style="{StaticResource PropertyName}" />
                                                        <StackPanel>
                                                            <StackPanel Visibility="Collapsed">
                                                                <TextBox Text="{Binding RequestBuilder.Types.FiltersString}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                <TextBlock Text="например: 200; 300; !404 " HorizontalAlignment="Right" Foreground="Gray" FontSize="11" />
                                                            </StackPanel>
                                                            <StackPanel DataContext="{Binding RequestFilters}">
                                                                <ItemsControl x:Name="TypeItems" ItemsSource="{Binding TypesList.List}" Margin="0,5">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <ToggleButton IsChecked="{Binding Enabled}" Margin="3,0">
                                                                                <TextBlock Text="{Binding Content}" Padding="15,0,8,0" Margin="1,0" />
                                                                                <ToggleButton.InputBindings>
                                                                                    <MouseBinding MouseAction="RightClick"
                                                                                                  Command="{Binding ElementName=TypeItems, Path=DataContext.RemoveFilterCommand}"
                                                                                                  CommandParameter="{Binding}" />
                                                                                </ToggleButton.InputBindings>
                                                                            </ToggleButton>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                                <UniformGrid Columns="2" Margin="8,4" HorizontalAlignment="Right"
                                                                             Visibility="{Binding Path=TypesSourceIsNotEmpty,Converter={StaticResource BooleanVisibility}}">
                                                                    <ComboBox SelectedItem="{Binding SelectedType}" ItemsSource="{Binding TypesSources}"/>
                                                                    <Button Content="добавить"
                                                                            Command="{Binding Path=AddFilterTypeCommand}"
                                                                            Style="{StaticResource ActionButton}" Margin="2,0">
                                                                        <Button.CommandParameter>
                                                                            <System:Boolean>true</System:Boolean>
                                                                        </Button.CommandParameter>
                                                                    </Button>
                                                                </UniformGrid>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    
                                                    <DockPanel Style="{StaticResource Property}">
                                                        <TextBlock Text="Коды ответа:" Style="{StaticResource PropertyName}" />
                                                        <StackPanel>
                                                            <StackPanel Visibility="Collapsed">
                                                                <TextBox Text="{Binding RequestBuilder.Codes.FiltersString}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                                                <TextBlock Text="например: text/html" HorizontalAlignment="Right" Foreground="Gray" FontSize="11" />
                                                            </StackPanel>
                                                            <StackPanel DataContext="{Binding RequestFilters}" Margin="0,5">
                                                                <ItemsControl x:Name="CodeItems" ItemsSource="{Binding CodesList.List}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <ToggleButton IsChecked="{Binding Enabled}" Margin="3,0">
                                                                                <TextBlock Text="{Binding Content}" Padding="15,0,8,0" Margin="1,0" />
                                                                                <ToggleButton.InputBindings>
                                                                                    <MouseBinding MouseAction="RightClick"
                                                                                                  Command="{Binding ElementName=CodeItems, Path=DataContext.RemoveFilterCommand}"
                                                                                                  CommandParameter="{Binding}" />
                                                                                </ToggleButton.InputBindings>
                                                                            </ToggleButton>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                </ItemsControl>
                                                                <UniformGrid Columns="2" Margin="8,4" HorizontalAlignment="Right"
                                                                             Visibility="{Binding Path=CodesSourceIsNotEmpty,Converter={StaticResource BooleanVisibility}}">
                                                                    <ComboBox SelectedItem="{Binding SelectedCode}" ItemsSource="{Binding CodesSources}"/>
                                                                    <Button Content="добавить"
                                                                            Command="{Binding Path=AddFilterCodeCommand}"
                                                                            Style="{StaticResource ActionButton}" Margin="2,0">
                                                                        <Button.CommandParameter>
                                                                            <System:Boolean>true</System:Boolean>
                                                                        </Button.CommandParameter>
                                                                    </Button>
                                                                </UniformGrid>
                                                            </StackPanel>

                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                                <StackPanel Margin="0,5">

                                                    <DockPanel Style="{StaticResource Property}">
                                                        <TextBlock Text="Запрос:" Style="{StaticResource PropertyName}" />
                                                        <StackPanel>
                                                            <TextBox Text="{Binding RequestString, Mode=OneWay}" IsReadOnly="True"
                                                                     FontSize="9" Foreground="Gray"
                                                                     TextWrapping="Wrap" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </StackPanel>
                                                <StackPanel Margin="0,5">
                                                    <UniformGrid>
                                                        <Button Content="Скопировать запрос" ToolTip="{Binding RequestBuilder.Request}"
                                    Command="{Binding CopyRequestCommand}" CommandParameter="{Binding RequestBuilder.Request}" 
                                    Margin="5,0">
                                                            <Button.Style>
                                                                <Style TargetType="Button" BasedOn="{StaticResource ActionButton}">
                                                                </Style>
                                                            </Button.Style>
                                                        </Button>
                                                        <Button Content="Отправить и загрузить" Command="{Binding LoadFromRequestBuilderCommand}"
                                    Style="{StaticResource ActionButton}" Margin="5,0" />
                                                    </UniformGrid>
                                                </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </TabItem>
                                    <TabItem>
                                        <TabItem.Header>
                                            <TextBlock Text="Загрузить из файла" />
                                        </TabItem.Header>
                                        <Button Content="Загрузить из файла" Command="{Binding Path=LoadFromFileCommand}" Style="{StaticResource ActionButton}" VerticalAlignment="Top" />
                                    </TabItem>
                                </TabControl>
                            </ScrollViewer>
                            <StackPanel x:Name="snapshot" Grid.Column="1" Margin="5" >
                                
                                <Border Style="{DynamicResource HeaderPanel}">
                                    <TextBlock Text="Загрузка" FontSize="18" />
                                </Border>
                                
                                <StackPanel Margin="0,5">
                                    <ProgressBar Grid.Row="0" Grid.ColumnSpan="2" Value="{Binding Status.ReadyPercentage,Mode=OneWay}" Maximum="100" Margin="0,1" />
                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Статус:" Style="{StaticResource PropertyName}" />
                                        <DockPanel Style="{StaticResource Property}">
                                            <Rectangle Fill="Gainsboro" Stroke="Gray" Height="10" Width="10" Margin="5,0" RenderTransformOrigin="0.5,0.5">
                                                <Rectangle.RenderTransform>
                                                    <RotateTransform x:Name="noFreeze" />
                                                </Rectangle.RenderTransform>
                                                <Rectangle.Style>
                                                    <Style TargetType="Rectangle">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsProcessing}" Value="true">
                                                                <Setter Property="Fill" Value="green" />
                                                                <DataTrigger.EnterActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard TargetProperty="(RenderTransform).(RotateTransform.Angle)">
                                                                            <DoubleAnimation To="360" RepeatBehavior="Forever" Duration="0:0:1" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.EnterActions>
                                                                <DataTrigger.ExitActions>
                                                                    <BeginStoryboard>
                                                                        <Storyboard TargetProperty="(RenderTransform).(RotateTransform.Angle)">
                                                                            <DoubleAnimation To="0"  Duration="0:0:0.1" />
                                                                        </Storyboard>
                                                                    </BeginStoryboard>
                                                                </DataTrigger.ExitActions>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Rectangle.Style>
                                            </Rectangle>
                                            <TextBlock Text="{Binding Status.Status}" TextWrapping="Wrap" />
                                        </DockPanel>
                                    </DockPanel>

                                    <TreeView ItemsSource="{Binding Path=LoadingEventsList}" BorderThickness="0" ItemContainerStyle="{StaticResource TreeViewStrech}" MaxHeight="250">
                                        <TreeView.Resources>
                                            <Style x:Key="BorderCheck" TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Green" />
                                                <Setter Property="BorderThickness" Value="4,0,0,0" />
                                                <Setter Property="Padding" Value="5,0" />
                                                <Setter Property="CornerRadius" Value="2" />
                                            </Style>
                                            
                                            <DataTemplate DataType="{x:Type linkload:SnapshotLoaderEventArgs}">
                                                <Border x:Name="border" Style="{StaticResource BorderCheck}">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding State.Date, Converter={StaticResource DateConverter},ConverterParameter=HH:mm:ss}" FontSize="11" Margin="4,0" />
                                                        <TextBlock Text="{Binding State.Status}" FontSize="11" Margin="4,0" />
                                                        <Rectangle x:Name="endRectangle" Fill="DarkOrange" Height="2" Width="10" VerticalAlignment="Center" Visibility="Collapsed" />
                                                        <Button x:Name="exceptionButton" Command="{StaticResource OpenExceptionCommand}" CommandParameter="{Binding State.Exception}" Style="{StaticResource ExceptionButton}" />
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding State.IsSuccessfull}" Value="false">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="red" />
                                                        <Setter TargetName="exceptionButton" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding State.IsEnded}" Value="true">
                                                        <Setter TargetName="endRectangle" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                            <Style TargetType="{x:Type TreeViewItem}">
                                                <Style.Resources>
                                                    <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="Transparent"/>
                                                    <SolidColorBrush x:Key="{x:Static SystemColors.InactiveSelectionHighlightBrushKey}" Color="Transparent"/>
                                                    <Style TargetType="{x:Type Border}">
                                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                                    </Style>
                                                </Style.Resources>
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                                <Setter Property="FontWeight" Value="Normal" />

                                            </Style>

                                        </TreeView.Resources>
                                    </TreeView>


                                    <UniformGrid>
                                        <Button Content="Прервать" Command="{Binding BreakRequestCommand}"
                                                Margin="5,2" Style="{StaticResource ActionButton}"
                                                Visibility="{Binding IsProcessing,Converter={StaticResource BooleanVisibility}}">
                                        </Button>
                                    </UniformGrid>
                                </StackPanel>

                                <StackPanel Visibility="{Binding MainModel.SnapshotView.CurrentSnapshot.IsNotEmpty,Converter={StaticResource BooleanVisibility}, FallbackValue=Collapsed}">
                                    <Border Style="{DynamicResource HeaderPanel}">
                                        <TextBlock Text="Полученный снапшот" FontSize="18" />
                                    </Border>

                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Адрес:" Style="{StaticResource PropertyName}" />
                                        <TextBlock Text="{Binding MainModel.SnapshotView.CurrentSnapshot.SourceURI}" />
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Ссылок:" Style="{StaticResource PropertyName}"/>
                                        <TextBlock Text="{Binding MainModel.SnapshotView.CurrentSnapshot.Links.Length}"  />
                                    </DockPanel>

                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Получено в:" Style="{StaticResource PropertyName}"/>
                                        <TextBlock Text="{Binding MainModel.SnapshotView.CurrentSnapshot.ReceivingDate,StringFormat=dd-MM-yyyy; HH:mm}" FontSize="12"/>
                                    </DockPanel>

                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Сохранение:" Style="{StaticResource PropertyName}"/>
                                        <TextBlock Text="{Binding MainModel.SnapshotView.LastSaveDate,StringFormat=dd-MM-yyyy; HH:mm}" FontSize="12"/>
                                    </DockPanel>

                                    <Separator BorderThickness="0,0,0,1" BorderBrush="Gainsboro" />


                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Файл снапшота:" Width="120" Style="{StaticResource PropertyName}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SnapshotView.File.FullName,TargetNullValue=Сохранения еще не происходило, FallbackValue=Сохранения еще не происходило}"
                                                       Style="{StaticResource TextBlockLink}"
                                                       FontSize="10" Margin="0,5">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{StaticResource OpenLinkCommand}" CommandParameter="{Binding SnapshotView.File.FullName}" />
                                                </TextBlock.InputBindings>
                                            </TextBlock>
                                            <UniformGrid>
                                                <Button Command="{StaticResource OpenLinkCommand}" CommandParameter="{Binding MainModel.SnapshotView.File.Directory.FullName}"  Style="{StaticResource ActionButton}">
                                                    <TextBlock Text="Открыть папку" FontSize="12"/>
                                                </Button>
                                                <Button Command="{Binding MainModel.SnapshotView.SaveSnapFileCommand}" CommandParameter="All" Style="{StaticResource ActionButton}" >
                                                    <TextBlock Text="Сохранить как" FontSize="12" />
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Папка контента:" Width="120" Style="{StaticResource PropertyName}"/>
                                        <StackPanel>
                                            <TextBlock Text="{Binding SnapshotView.SavingFolderHtmlContent.FullName,TargetNullValue=Сохранения еще не происходило, FallbackValue=Сохранения еще не происходило}"
                                                       TextWrapping="Wrap" Style="{StaticResource TextBlockLink}"
                                                       FontSize="10" Margin="0,5">
                                                <TextBlock.InputBindings>
                                                    <MouseBinding MouseAction="LeftClick" Command="{StaticResource OpenLinkCommand}" CommandParameter="{Binding SnapshotView.SavingFolderHtmlContent.FullName}" />
                                                </TextBlock.InputBindings>
                                            </TextBlock>

                                            <UniformGrid>
                                                <Button Command="{Binding MainModel.SnapshotView.SelectSaveFolderCommand}" CommandParameter="{Binding MainModel.SnapshotView.CurrentSnapshot.FilePath}" Style="{StaticResource ActionButton}">
                                                    <TextBlock Text="Сменить папку" FontSize="12" />
                                                </Button>
                                                <Button Command="{Binding MainModel.SnapshotView.ClearProgressCommand}" Style="{StaticResource ActionButton}" >
                                                    <TextBlock Text="Сбросить прогресс загрузки" FontSize="12" />
                                                </Button>
                                            </UniformGrid>
                                        </StackPanel>
                                    </DockPanel>
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Visibility="{Binding SnapshotIsNotEmpty, Converter={StaticResource BooleanVisibility}}">
                        <TabItem.Header>
                            <TextBlock Text="Список ссылок" FontSize="16" />
                        </TabItem.Header>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="3*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>

                            <Border Grid.Row="0" BorderThickness="0,1" BorderBrush="Gainsboro" Padding="0,6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="8*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DockPanel Margin="0,0,5,0" Grid.Column="0">
                                        <TextBlock Text="Коды:" Margin="5,0"/>
                                        <ItemsControl ItemsSource="{Binding SnapshotView.ViewOptions.Codes}" VerticalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Content="{Binding Code}" IsChecked="{Binding Enabled}" Click="ToggleButton_Click" Padding="15,0,8,0" Margin="1,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DockPanel>
                                    <DockPanel Margin="5,0" Grid.Column="1">
                                        <TextBlock Text="Типы:" Margin="5,0"/>
                                        <ItemsControl ItemsSource="{Binding SnapshotView.ViewOptions.Types}" VerticalAlignment="Center">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <ToggleButton Content="{Binding Type}" IsChecked="{Binding Enabled}" Click="ToggleButton_Click" Padding="15,0,8,0" Margin="1,0"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </DockPanel>
                                </Grid>
                            </Border>

                            <DockPanel Grid.Row="1" Margin="0,5">

                                <DockPanel Grid.Row="0" Margin="5,0">
                                    <TextBlock Text="Поиск:" ToolTip="Производится по оригинальной ссылке и имени" />
                                    <TextBox Text="{Binding SnapshotView.ViewOptions.Search,UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" MinWidth="120" BorderThickness="0,0,0,1" Margin="5,0"/>
                                </DockPanel>

                                <!--ПАГИНАЦИЯ ОТКЛЮЧЕНА-->
                                <DockPanel x:Name="pagination">
                                    <Button Padding="15,0" Margin="0,0,2,0" ToolTip="Перейти на первую страницу" Command="{Binding LinksPager.SetPageCommand}" CommandParameter="{Binding LinksPager.PageMinAmount}">
                                        <TextBlock Text="{Binding LinksPager.PageMinAmount,StringFormat=\{0\} ←}"/>
                                    </Button>
                                    <Button Content="←" Padding="15,0" Margin="0,0,5,0" ToolTip="Перейти на предыдущую страницу"  Command="{Binding LinksPager.PrevPageCommand}" />
                                    <ListBox ItemsSource="{Binding LinksPager.PagesAvailable}" SelectedItem="{Binding LinksPager.PageNowNumber}">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Padding="3,0" Cursor="Hand" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                        <ListBox.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ListBox.ItemsPanel>
                                    </ListBox>
                                    <Button Content="→" Padding="15,0" Margin="5,0,2,0" ToolTip="Перейти на следующую страницу" Command="{Binding LinksPager.NextPageCommand}" />
                                    <Button  Padding="15,0" Margin="0,0,5,0" ToolTip="Перейти на последнюю страницу" Command="{Binding LinksPager.SetPageCommand}" CommandParameter="{Binding LinksPager.PageMaxAmount}">
                                        <TextBlock Text="{Binding LinksPager.PageMaxAmount,StringFormat=→ {0}}"/>
                                    </Button>

                                    <DockPanel.Style>
                                        <Style TargetType="DockPanel">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding LinksPager.PageMaxAmount}" Value="1">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DockPanel.Style>
                                </DockPanel>
                                
                                <DockPanel DockPanel.Dock="Right">

                                    <DockPanel DockPanel.Dock="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="Стр." Margin="5,0" />
                                        <TextBox Text="{Binding LinksPager.PageNowNumber, UpdateSourceTrigger=PropertyChanged}" VerticalContentAlignment="Center"/>
                                        <TextBlock Text="из" Margin="5,0" />
                                        <TextBlock Text="{Binding LinksPager.PageMaxAmount}"/>
                                        <TextBlock Text="по" Margin="5,0" />
                                        <ComboBox SelectedItem="{Binding LinksPager.ElementsPerPage}">
                                            <System:Int32>50</System:Int32>
                                            <System:Int32>100</System:Int32>
                                            <System:Int32>250</System:Int32>
                                            <System:Int32>500</System:Int32>
                                            <System:Int32>1000</System:Int32>
                                            <System:Int32>2000</System:Int32>
                                            <System:Int32>5000</System:Int32>
                                            <System:Int32>10000</System:Int32>
                                            <System:Int32>100000</System:Int32>
                                        </ComboBox>
                                        <TextBlock Text="ссылок" Margin="5,0" />
                                    </DockPanel>
                                </DockPanel>
                                <Slider Grid.Row="1" Minimum="1"  Margin="5,0" Maximum="{Binding LinksPager.PageMaxAmount}" Visibility="Collapsed"
                                Value="{Binding LinksPager.PageNowNumber, UpdateSourceTrigger=PropertyChanged}" AutoToolTipPlacement="TopLeft" TickPlacement="BottomRight" />
                            </DockPanel>

                            <controls:ListLinks Grid.Row="2" LinksPager="{Binding LinksPager}" />

                            <GridSplitter Grid.Row="2" Grid.Column="0" Height="2" VerticalAlignment="Top" HorizontalAlignment="Stretch" Panel.ZIndex="100" />

                            <Grid Grid.Column="2" Grid.Row="3">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <controls:IntervalSliderLinks Grid.Row="0"
                                                              Margin="5,0"
                                                              Statistics="{Binding SnapshotView.DatesStatistics}"
                                                              Minimum="0" Maximum="{Binding SnapshotView.ViewOptions.DateRange.Difference}"
                                                              LowerValue="{Binding SnapshotView.ViewOptions.DateRange.DifferenceFrom, Mode=TwoWay}"
                                                              UpperValue="{Binding SnapshotView.ViewOptions.DateRange.DifferenceTo, Mode=TwoWay}"
                                                              Visibility="{Binding SnapshotIsNotEmpty,Converter={StaticResource BooleanVisibility}}"/>
                                <DockPanel Grid.Row="1">
                                    <DockPanel DockPanel.Dock="Left" VerticalAlignment="Bottom">
                                        <DatePicker SelectedDate="{Binding SnapshotView.ViewOptions.DateRange.From}" />
                                        <TextBlock Text="{Binding SnapshotView.ViewOptions.DateRange.From, ConverterParameter=dd.MM.yyyy, Converter={StaticResource DateConverter}}"/>
                                    </DockPanel>
                                    <DockPanel HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                        <TextBlock Text="{Binding SnapshotView.ViewOptions.DateRange.To, ConverterParameter=dd.MM.yyyy, Converter={StaticResource DateConverter}}"/>
                                        <DatePicker SelectedDate="{Binding SnapshotView.ViewOptions.DateRange.To}" />
                                    </DockPanel>
                                </DockPanel>

                            </Grid>
                        </Grid>
                    </TabItem>
                    <TabItem Visibility="{Binding SnapshotIsNotEmpty, Converter={StaticResource BooleanVisibility}}">
                        <TabItem.Header>
                            <TextBlock Text="Настройки отображения" FontSize="16" />
                        </TabItem.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel DataContext="{Binding SnapshotView.ViewOptions}">


                                <StackPanel Margin="5">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="Gainsboro">
                                        <TextBlock FontSize="20" Text="Настройки сайта" />
                                    </Border>
                                </StackPanel>

                                <DockPanel Style="{StaticResource Property}">
                                    <TextBlock Text="Сортировка"  Style="{DynamicResource PropertyName}" />
                                    <ComboBox ItemsSource="{Binding ListView.Sorts}" SelectedItem="{Binding ListView.SortSelected}" DisplayMemberPath="Name" HorizontalContentAlignment="Center"/>
                                </DockPanel>
                                <DockPanel Style="{StaticResource Property}">
                                    <TextBlock Text="Группировка"  Style="{DynamicResource PropertyName}" />
                                    <ComboBox ItemsSource="{Binding ListView.Groups}" SelectedItem="{Binding ListView.GroupSelected}" DisplayMemberPath="Name" HorizontalContentAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Grid>
                    </TabItem>
                    <TabItem Visibility="{Binding SnapshotIsNotEmpty, Converter={StaticResource BooleanVisibility}}">
                        <TabItem.Header>
                            <TextBlock Text="Загрузка контента страниц" FontSize="16" />
                        </TabItem.Header>

                        <Grid DataContext="{Binding LoadHtmlView}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="3*" />
                                <ColumnDefinition Width="4*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="1*" />
                                <RowDefinition Height="1*" />
                            </Grid.RowDefinitions>
                            <GroupBox Grid.Row="0" Grid.Column="0">
                                <GroupBox.Header>
                                    <TextBlock Text="Настройки загрузки" />
                                </GroupBox.Header>

                                <StackPanel Grid.Row="0" Margin="25,0,0,0">
                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Таймаут:" Style="{StaticResource PropertyName}" />
                                        <StackPanel Style="{StaticResource PropertiesPanel}">
                                            <TextBlock Text="{Binding Options.TimeoutMinutes, StringFormat=\{0\} минут}"  />
                                            <Slider Minimum="1" Maximum="60" Value="{Binding Options.TimeoutMinutes}" IsSnapToTickEnabled="True" TickFrequency="1"/>
                                        </StackPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Папка:" Style="{StaticResource PropertyName}" />
                                        <DockPanel>
                                            <Button Command="{Binding SnapshotView.SelectSaveFolderCommand}" Style="{StaticResource ActionButton}"  HorizontalAlignment="Right">
                                                <TextBlock Text="{Binding SnapshotView.SavingFolderHtmlContent.Name,StringFormat=({0})}" ToolTip="{Binding Snapshot.FolderHtmlSavePath}" TextWrapping="Wrap" MaxWidth="333"/>
                                            </Button>
                                            <Button Command="{StaticResource OpenLinkCommand}" CommandParameter="{Binding Snapshot.FolderHtmlSavePath}" Style="{StaticResource ActionButton}"  HorizontalAlignment="Right">
                                                <TextBlock Text="Открыть" />
                                            </Button>
                                        </DockPanel>
                                    </DockPanel>
                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Что загружать:" Style="{StaticResource PropertyName}" />
                                        <DockPanel VerticalAlignment="Center">
                                            <CheckBox IsChecked="{Binding ProcessingConfiguration.LoadingTitle}">
                                                <TextBlock Text="Имена страниц" />
                                            </CheckBox>
                                            <CheckBox IsChecked="{Binding ProcessingConfiguration.SavingHtml}" Margin="5,0">
                                                <TextBlock Text="HTML" />
                                            </CheckBox>
                                        </DockPanel>
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2">
                                <GroupBox.Header>
                                    <TextBlock Text="Процесс загрузки" />
                                </GroupBox.Header>

                                <StackPanel Margin="20,0,0,0">
                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Начало:" Style="{StaticResource PropertyName}" />
                                        <StackPanel Style="{StaticResource PropertiesPanel}">
                                            <DockPanel>
                                                <TextBlock Text="{Binding PauseState.StartDateTime, StringFormat=HH:mm начало\,}" />
                                                <DockPanel Margin="4,0" Visibility="Collapsed">
                                                    <TextBlock Text="{Binding PauseState.FromStart.TotalMinutes, ConverterParameter=0, Converter={StaticResource MathRound}, StringFormat=\{0\}:}" />
                                                    <TextBlock Text="{Binding PauseState.FromStart.Seconds, Converter={StaticResource MathRound}, StringFormat=\{0\} прошло}" Margin="1,0"/>
                                                </DockPanel>
                                                <TextBlock HorizontalAlignment="Right" Text="{Binding SpeedLinksPerMinute, Converter={StaticResource MathRound}, StringFormat=~ \{0\} ссылок в минуту}" />
                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Прогресс:" Style="{StaticResource PropertyName}" />
                                        <StackPanel Style="{StaticResource PropertiesPanel}">
                                            <ProgressBar Value="{Binding LinksLoadedCount, Mode=OneWay}" Maximum="{Binding Snapshot.Links.Length}" Height="6">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar">
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding PauseState.IsPaused}" Value="true">
                                                                <Setter Property="Foreground" Value="DarkGray" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <Grid Margin="25,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1*" />
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                    <ColumnDefinition Width="1*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" ToolTip="Осталось ссылок" Text="{Binding LinksRemaining.Count, StringFormat=\{0\}}" Margin="3,0" FontSize="18" Foreground="Blue"/>
                                                <TextBlock Grid.Column="1" Text="→" Margin="3,0" FontSize="18" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="2" ToolTip="Загружающихся ссылок" Text="{Binding CurrentRequests.Count, StringFormat=\{0\}}" Margin="3,0" FontSize="18" Foreground="DarkGoldenrod" HorizontalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="→" Margin="3,0" FontSize="18" HorizontalAlignment="Center" />
                                                <TextBlock Grid.Column="4" ToolTip="Загруженных ссылок" Text="{Binding LinksLoadedCount, StringFormat=\{0\}}" Margin="3,0" FontSize="18" Foreground="Green" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </StackPanel>
                                    </DockPanel>

                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Сейчас:" Style="{StaticResource PropertyName}" />
                                        <DockPanel>
                                            <TextBlock Text="{Binding LastLink.Index}" />
                                            <TextBlock Text="-" Margin="3,0" />
                                            <TextBlock Text="{Binding LastLink.Name}" />
                                        </DockPanel>
                                    </DockPanel>

                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Ошибки:" Style="{StaticResource PropertyName}" />
                                        <DockPanel>
                                            <TextBlock Text="{Binding LogError.Count, StringFormat=\{0\}}" Margin="3,0" FontSize="16" Foreground="Red"/>
                                            <TextBlock Text="{Binding Log.Count, StringFormat=из \{0\}}" Margin="3,0"  FontSize="16"/>
                                        </DockPanel>

                                    </DockPanel>

                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Осталось времени:" Style="{StaticResource PropertyName}" />
                                        <StackPanel Style="{StaticResource PropertiesPanel}">

                                            <DockPanel>
                                                <TextBlock Text="{Binding TimeLeft.TotalMinutes, ConverterParameter=0, Converter={StaticResource MathRound}, StringFormat=\{0\}:}" />
                                                <TextBlock Text="{Binding TimeLeft.Seconds, Converter={StaticResource MathRound}, StringFormat=\{0\} осталось}" Margin="1,0"/>

                                            </DockPanel>
                                        </StackPanel>
                                    </DockPanel>

                                </StackPanel>
                            </GroupBox>

                            <GroupBox Grid.Column="1">
                                <GroupBox.Header>
                                    <TextBlock Text="Действия" />
                                </GroupBox.Header>
                                <StackPanel Margin="20,0,0,0">
                                    <DockPanel Style="{StaticResource Property}">
                                        <TextBlock Text="Действия:" Style="{StaticResource PropertyName}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*" />
                                                <!--<ColumnDefinition Width="1*"/>-->
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <Button Grid.Column="0" Content="Запустить загрузку" Command="{Binding StartDownloadCommand}" Style="{StaticResource ActionButton}" />
                                            <Button Grid.Column="2" Content="Завершить загрузку" Command="{Binding StopProgressCommand}" Style="{StaticResource ActionButton}"/>
                                        </Grid>
                                    </DockPanel>
                                    <Grid Margin="0,3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="1*" />
                                            <ColumnDefinition Width="1*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Grid.Column="0" Content="| |" IsChecked="{Binding PauseState.IsPaused}" IsEnabled="{Binding IsPauseEnabled}" Padding="15,2" Margin="5,0" Background="White" BorderThickness="1" />
                                        <ToggleButton Grid.Column="1" Content="&gt;" IsChecked="{Binding PauseState.IsPlayed}" IsEnabled="{Binding IsPauseEnabled}" Padding="15,2" Margin="5,0" Background="White" BorderThickness="1" />
                                    </Grid>
                                    <DockPanel>
                                        <DockPanel>
                                            <Button Command="{Binding SaveProgressCommand}" Style="{StaticResource ActionButton}"  HorizontalAlignment="Right">
                                                <TextBlock Text="сохранить" />
                                            </Button>
                                        </DockPanel>
                                        <TextBlock Text="{Binding SnapshotView.LastSaveDate, StringFormat=HH:mm сохранение}" Margin="4,0"/>
                                    </DockPanel>
                                </StackPanel>
                            </GroupBox>


                            <TabControl Grid.Row="0" Grid.Column="2" Grid.RowSpan="2">
                                <TabControl.Resources>
                                    <DataTemplate x:Key="Request" DataType="{x:Type htmload:LinkProcessing}">
                                        <Border BorderThickness="0,0,0,1" Margin="0,3" BorderBrush="WhiteSmoke">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Grid.Row="0" Text="{Binding Link.Index}" FontSize="12" Margin="4,0"/>
                                                <!--<TextBlock Grid.Column="1" Grid.Row="0" Text="{Binding Status}" FontSize="9" Foreground="Gray" TextWrapping="Wrap" Margin="5,0" VerticalAlignment="Center"/>-->
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                    <DataTemplate x:Key="Log" DataType="{x:Type htmload:LinkProcessingEventArgs}">
                                        <Border BorderThickness="0,0,0,1" Margin="0,3" BorderBrush="WhiteSmoke">
                                            <Grid ToolTip="{Binding State.Date}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto" />
                                                    <RowDefinition />
                                                </Grid.RowDefinitions>
                                                <TextBlock Grid.Column="0" Grid.Row="1"
                                           x:Name="date" Text="{Binding State.Date, Converter={StaticResource DateConverter},ConverterParameter=dd-MMM-yyyy\, HH:mm:ss, FallbackValue=Даты пока нет}"
                                           FontSize="12"
                                           Margin="0,0,10,0"/>
                                                <TextBlock Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                                           Text="{Binding Sender.Link.Link}" 
                                           FontSize="9" Foreground="Gray" />
                                                <TextBlock Grid.Column="1" Grid.Row="1"
                                           x:Name="message"
                                           Text="{Binding State.Status}"
                                           FontSize="12" />
                                            </Grid>
                                        </Border>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding State.IsSuccessfull}" Value="false">
                                                <Setter TargetName="message" Property="Foreground" Value="Red" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </TabControl.Resources>
                                <TabItem>
                                    <TabItem.Header>
                                        <DockPanel>
                                            <TextBlock Text="{Binding CurrentRequests.Count, StringFormat=[\{0\}]}" Margin="3,0"/>
                                            <TextBlock Text="Текущие" />
                                        </DockPanel>

                                    </TabItem.Header>
                                    <ScrollViewer MaxHeight="250">
                                        <ItemsControl ItemsSource="{Binding CurrentRequests}" ItemTemplate="{DynamicResource Request}" />
                                    </ScrollViewer>
                                </TabItem>
                                <TabItem>
                                    <TabItem.Header>
                                        <DockPanel>
                                            <TextBlock Text="{Binding Log.Count, StringFormat=[\{0\}]}" Margin="3,0"/>
                                            <TextBlock Text="История" />
                                        </DockPanel>

                                    </TabItem.Header>
                                    <TreeView ItemsSource="{Binding Path=LinkProcessings}" BorderThickness="0" ItemContainerStyle="{StaticResource TreeViewStrech}">
                                        <TreeView.Resources>
                                            
                                            <Style x:Key="BorderCheck" TargetType="Border">
                                                <Setter Property="BorderBrush" Value="Green" />
                                                <Setter Property="BorderThickness" Value="4,0,0,0" />
                                                <Setter Property="Padding" Value="5,0" />
                                                <Setter Property="CornerRadius" Value="2" />
                                            </Style>

                                            <HierarchicalDataTemplate DataType="{x:Type viewmodels:LinkProcessingViewModel}" ItemsSource="{Binding Logs}">
                                                <Border x:Name="border" Style="{StaticResource BorderCheck}" Margin="0,3">
                                                    <StackPanel>
                                                        <DockPanel>
                                                            <TextBlock Text="{Binding Link.TimeStamp}" Foreground="Gray" FontSize="11" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding Link.Index}" Margin="5,0" Width="40" TextAlignment="Right" Foreground="Gray" FontSize="11" HorizontalAlignment="Right" />
                                                            <TextBlock Text="{Binding Link.LinkSource}" Foreground="Black" FontSize="11" Margin="15,0" />
                                                        </DockPanel>
                                                        <ProgressBar Height="1.5" Minimum="0" Maximum="100" Foreground="LightGreen" Value="{Binding LastProgress.ReadyPercentage, Mode=OneWay}" />
                                                    </StackPanel>
                                                </Border>
                                                <HierarchicalDataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding LastProgress.IsSuccessfull}" Value="false">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="red" />
                                                    </DataTrigger>
                                                </HierarchicalDataTemplate.Triggers>
                                            </HierarchicalDataTemplate>

                                            <DataTemplate DataType="{x:Type Lib:ProcessStatus}">
                                                <Border x:Name="border" Style="{StaticResource BorderCheck}">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Date, Converter={StaticResource DateConverter},ConverterParameter=HH:mm:ss}" FontSize="11" />
                                                        <TextBlock Text="{Binding Status}" FontSize="11" Margin="4,0" />
                                                        <Button x:Name="exceptionButton" Command="{StaticResource OpenExceptionCommand}" CommandParameter="{Binding Exception}" Style="{StaticResource ExceptionButton}" />

                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccessfull}" Value="false">
                                                        <Setter TargetName="border" Property="BorderBrush" Value="red" />
                                                        <Setter TargetName="exceptionButton" Property="Visibility" Value="Visible" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>

                                        </TreeView.Resources>
                                    </TreeView>
                                </TabItem>
                            </TabControl>
                        </Grid>
                    </TabItem>
                </TabControl>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Background="WhiteSmoke"
                   BorderThickness="0,1,0,0" Padding="0,5" BorderBrush="Gainsboro" >
            <StatusBarItem Margin="5,0">
                <StackPanel Orientation="Horizontal">
                    <TextBlock >
                        <Run Text="Статус:" Foreground="Gray" />
                        <Run Text="{Binding Operation.Status, Mode=OneWay}" />
                    </TextBlock>
                    <ProgressBar Height="8" Width="100"
                                 Margin="6,6,6,4"
                                 Minimum="0" Value="{Binding Operation.ReadyPercentage,Mode=OneWay}" Maximum="100"
                                 VerticalAlignment="Center" />
                </StackPanel>
            </StatusBarItem>
            <StatusBarItem Margin="5,0">
                <TextBlock >
                    <Run Text="Снапшот:" Foreground="Gray" />
                    <Run Text="{Binding SnapshotView.Status, Mode=OneWay}" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Margin="5,0">
                <TextBlock >
                    <Run Text="Файл:" Foreground="Gray" />
                    <Run Text="{Binding SnapshotView.File.Name,Mode=OneWay, StringFormat=\{0\},FallbackValue=отсутствует, TargetNullValue=не открыт}" />
                </TextBlock>
            </StatusBarItem>
            <StatusBarItem Margin="5,0" HorizontalAlignment="Right">
                <TextBlock>
                    <Run Text="  Всего ссылок:" Foreground="Gray" />
                    <Run Text="{Binding SnapshotView.CurrentSnapshot.Links.Length, Mode=OneWay, TargetNullValue=-}" />
                    <Run Text="  Отфильтровано:" Foreground="Gray" />
                    <Run Text="{Binding SnapshotView.ViewOptions.LinksFilteredAmount, Mode=OneWay, TargetNullValue=-}" />
                    <Run Text="  Показано:" Foreground="Gray" />
                    <Run Text="{Binding LinksPager.PageNow.Source.Source.Count, Mode=OneWay,FallbackValue=-, TargetNullValue=-}" />
                </TextBlock>
            </StatusBarItem>
        </StatusBar>

    </Grid>
</Window>
