<Window x:Class="WebArchiveViewer.Views.Windows.RulesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WebArchiveViewer"
        xmlns:viewmodels="clr-namespace:WebArchiveViewer.ViewModels"
        xmlns:Lib="clr-namespace:WebArchive.Data;assembly=WebArchive.Data"
        mc:Ignorable="d"
        MaxWidth="1200"
        ResizeMode="CanResize"
        Icon="../../Resources/Веб-архив.png"
        Title="Групповые правила" Height="475" Width="700">
    <Window.DataContext>
        <viewmodels:RulesInfoViewModel />
    </Window.DataContext>
    <Grid x:Name="grid" >
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{DynamicResource HeaderPanelNew}">
            <TextBlock Text="Список правил формирования категорий" FontSize="16" FontWeight="Medium" />
        </Border>
        
        <ToolBar Grid.Row="1">
            <Button Content="Добавить правило"
                    Command="{Binding AddRuleCommand}"
                    CommandParameter="{Binding RulesControl}"
                    Margin="4,2" Padding="4,2"/>
            <Button Content="Обновить ссылки"
                    Command="{Binding SnapshotView.UpdateCategoriesCommand}"
                    Margin="4,2" Padding="4,2"/>
            <Separator />
            <Button Content="Вложить в правило"
                    Command="{Binding AddRuleCommand}"
                    CommandParameter="{Binding ElementName=rulesView,Path=SelectedItem}"
                    Margin="4,2" Padding="4,2"/>
            <Button Content="Удалить правило"
                    Command="{Binding RemoveRuleCommand}"
                    CommandParameter="{Binding ElementName=rulesView,Path=SelectedItem}"
                    Margin="4,2" Padding="4,2"/>
            <Separator />
            <Button Content="Вверх"
                    Command="{Binding MoveRuleUpCommand}"
                    CommandParameter="{Binding ElementName=rulesView,Path=SelectedItem}"
                    Margin="4,2" Padding="4,2"/>
            <Button Content="Вниз"
                    Command="{Binding MoveRuleDownCommand}"
                    CommandParameter="{Binding ElementName=rulesView,Path=SelectedItem}"
                    Margin="4,2" Padding="4,2"/>
        </ToolBar>
        <StackPanel Grid.Row="2">
            <TextBlock Text="Названия категорий должны быть уникальны!" Margin="12,2" Foreground="Gray" />
        </StackPanel>
        <TreeView Grid.Row="3"
                  x:Name="rulesView"
                  ItemsSource="{Binding RulesControl.Rules}"
                  BorderThickness="0,1,0,0"
                  Padding="0,4,0,0"
                  BorderBrush="Silver"
                  ItemContainerStyle="{StaticResource TreeViewStrech}">
            <TreeView.Resources>
                <HierarchicalDataTemplate ItemsSource="{Binding Rules}" DataType="{x:Type Lib:GroupRule}">
                    <Border>
                        <DockPanel Margin="0,2">
                            <TextBlock Text="{Binding Rules.Count,StringFormat=[\{0\}] }" Foreground="Black" Margin="5,0"/>
                            <TextBox Text="{Binding GroupName}" Background="Transparent" MinWidth="225"/>
                            <TextBox Text="{Binding FoundText}" Background="Transparent" HorizontalAlignment="Right" Margin="20,0"/>
                        </DockPanel>
                    </Border>
                </HierarchicalDataTemplate>
            </TreeView.Resources>
        </TreeView>
    </Grid>
</Window>
