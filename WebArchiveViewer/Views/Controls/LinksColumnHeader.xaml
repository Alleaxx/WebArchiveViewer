<UserControl x:Class="WebArchiveViewer.Views.Controls.LinksColumnHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WebArchiveViewer.Views.Controls"
             xmlns:webarchiveviewer="clr-namespace:WebArchiveViewer"
             d:DataContext="{d:DesignInstance Type=webarchiveviewer:MainWindowViewModel}"
             mc:Ignorable="d"
             Name="root"
             d:DesignHeight="50" d:DesignWidth="100">
    <UserControl.Resources>
        <Style x:Key="ButtonSort" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Button Command="{Binding SnapshotView.ViewOptions.ListView.SortCommand}"
            CommandParameter="{Binding ElementName=root, Path=ColumnInfo}"
            Style="{StaticResource ButtonSort}">

        <TextBlock Text="{Binding ElementName=root, Path=ColumnInfo.Name}" />

        <!--#region -->
        
        <!--#endregion-->
        <Button.ContextMenu>
            <ContextMenu Name="contextMenu">
                <MenuItem Header="Сортировать по столбцу"
                          Command="{Binding SnapshotView.ViewOptions.ListView.SortCommand}"
                          CommandParameter="{Binding ElementName=root, Path=ColumnInfo}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=root, Path=ColumnInfo.Sorting.Type}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="Группировать по столбцу"
                          Command="{Binding SnapshotView.ViewOptions.ListView.GroupCommand}"
                          CommandParameter="{Binding ElementName=root, Path=ColumnInfo}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=root, Path=ColumnInfo.Grouping.Type}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <!--<MenuItem Header="Убрать сортировку"
                          Command="{Binding SnapshotView.ViewOptions.ListView.RemoveSortCommand}"
                          CommandParameter="{Binding ElementName=root, Path=ColumnInfo}">
                </MenuItem>-->
                <MenuItem Header="Скрыть столбец"
                          Command="{Binding SnapshotView.ViewOptions.ShowColumns.HideColumnCommand}"
                          CommandParameter="{Binding ElementName=root, Path=ColumnInfo}">
                </MenuItem>
            </ContextMenu>
        </Button.ContextMenu>
    </Button>
</UserControl>
