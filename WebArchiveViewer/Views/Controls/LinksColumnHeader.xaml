<UserControl x:Class="WebArchiveViewer.Views.Controls.LinksColumnHeader"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:WebArchiveViewer.Views.Controls"
             xmlns:webarchiveviewer="clr-namespace:WebArchiveViewer.ViewModels"
             d:DataContext="{d:DesignInstance Type=webarchiveviewer:MainWindowViewModel}"
             mc:Ignorable="d"
             Name="root"
             d:DesignHeight="50" d:DesignWidth="100">
    <UserControl.Resources>
        <Style x:Key="ButtonSort" TargetType="{x:Type Button}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="4,0" />
            <Setter Property="Height" Value="18" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </UserControl.Resources>
    <Button Command="{Binding ElementName=root,Path=ColumnInfo.SortColumnCommand}"
            Style="{StaticResource ButtonSort}"
            HorizontalContentAlignment="Stretch" Cursor="Hand">

        <DockPanel>
            <TextBlock Text="{Binding ElementName=root, Path=ColumnInfo.Name}" FontSize="12">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=root, Path=ColumnInfo.IsGroupingSelected}" Value="true">
                                <Setter Property="FontWeight" Value="Bold" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <TextBlock Margin="4,0" HorizontalAlignment="Right">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Hidden" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ElementName=root, Path=ColumnInfo.IsSortingSelected}" Value="true">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=root, Path=ColumnInfo.Sorting.Ascending}" Value="true">
                                <Setter Property="Text" Value="▲" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding ElementName=root, Path=ColumnInfo.Sorting.Ascending}" Value="false">
                                <Setter Property="Text" Value="▼" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </DockPanel>

        <!--#region -->

        <!--#endregion-->
        <Button.InputBindings>
            <MouseBinding MouseAction="MiddleClick"
                          Command="{Binding ElementName=root,Path=ColumnInfo.GroupColumnCommand}"/>
        </Button.InputBindings>
        <Button.ContextMenu>
            <ContextMenu x:Name="contextMenu"
                         ItemContainerStyle="{StaticResource MenuItemCommand}"
                         ItemsSource="{Binding ElementName=root, Path=ColumnInfo.MenuCommands}">
            </ContextMenu>


            <!--<ContextMenu Name="contextMenu">
                <MenuItem Header="Сортировать по столбцу"
                          Command="{Binding SnapshotView.ListViewInfo.GroupSortsInfo.SortCommand}"
                          CommandParameter="{Binding ElementName=root, Path=ColumnInfo}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=root, Path=ColumnInfo.Sorting.Type}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                <MenuItem Header="Группировать по столбцу"
                          Command="{Binding SnapshotView.ListViewInfo.GroupSortsInfo.GroupCommand}"
                          CommandParameter="{Binding ElementName=root, Path=ColumnInfo}">
                    <MenuItem.Style>
                        <Style TargetType="MenuItem">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=root, Path=ColumnInfo.Grouping.Type}" Value="None">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </MenuItem.Style>
                </MenuItem>
                -->
            <!--<MenuItem Header="Убрать сортировку"
                          Command="{Binding SnapshotView.ViewOptions.ListView.RemoveSortCommand}"
                          CommandParameter="{Binding ElementName=root, Path=ColumnInfo}">
                </MenuItem>-->
            <!--
                <MenuItem Header="Скрыть столбец"
                          Command="{Binding SnapshotView.ListViewInfo.ColumnsInfo.HideColumnCommand}"
                          CommandParameter="{Binding ElementName=root, Path=ColumnInfo}">
                </MenuItem>
            </ContextMenu>-->




        </Button.ContextMenu>
    </Button>
</UserControl>
